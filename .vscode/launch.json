{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Build Documentation",
            "type": "debugpy",
            "request": "launch",
            "python": "${input:docsInterpreter}",
            "module": "sphinx",
            "args": ["-M", "html", ".", "_build"],
            "cwd": "${workspaceFolder}/docs",
            "console": "internalConsole",
            "justMyCode": false,
        },
        {
            "name": "Python: Debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "internalConsole",
            "justMyCode": false,
        },
        {
            "name": "Python: Debug Test",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "purpose": ["debug-test"],
            "console": "internalConsole",
            "justMyCode": false,
            "env": { "PYTEST_ADDOPTS": "--color=yes" },
            "presentation": { "hidden": true },
        },
        {
            "name": "Lesson 0: Build & inspect fixtures",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "program": "${workspaceFolder}/learn/hvg_csc_dask/build_fixtures.py",
            "args": ["--force"],
            "cwd": "${workspaceFolder}/learn/hvg_csc_dask",
            "console": "internalConsole",
            "justMyCode": false,
            "presentation": { "group": "HVG lessons", "order": 1 },
        },
        {
            "name": "Lesson 1: Dispersion (seurat, single batch)",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "module": "pytest",
            "args": [
                "-vv",
                "-s",
                "test_dispersion_ooc.py::test_dispersion_matches_in_memory[single-seurat]",
            ],
            "cwd": "${workspaceFolder}/learn/hvg_csc_dask",
            "console": "internalConsole",
            "justMyCode": false,
            "env": { "PYTEST_ADDOPTS": "--color=yes" },
            "presentation": { "group": "HVG lessons", "order": 2 },
        },
        {
            "name": "Lesson 2: Dispersion (cell_ranger, batched)",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "module": "pytest",
            "args": [
                "-vv",
                "-s",
                "test_dispersion_ooc.py::test_dispersion_matches_in_memory[batched-cell_ranger]",
            ],
            "cwd": "${workspaceFolder}/learn/hvg_csc_dask",
            "console": "internalConsole",
            "justMyCode": false,
            "env": { "PYTEST_ADDOPTS": "--color=yes" },
            "presentation": { "group": "HVG lessons", "order": 3 },
        },
        {
            "name": "Lesson 3: seurat_v3 (single batch, new clip branch)",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "module": "pytest",
            "args": [
                "-vv",
                "-s",
                "test_seurat_v3_ooc.py::test_seurat_v3_matches_in_memory[single-seurat_v3]",
            ],
            "cwd": "${workspaceFolder}/learn/hvg_csc_dask",
            "console": "internalConsole",
            "justMyCode": false,
            "env": { "PYTEST_ADDOPTS": "--color=yes" },
            "presentation": { "group": "HVG lessons", "order": 4 },
        },
        {
            "name": "Lesson 4: seurat_v3 (batched, aggregate + row masking)",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "module": "pytest",
            "args": [
                "-vv",
                "-s",
                "test_seurat_v3_ooc.py::test_seurat_v3_matches_in_memory[batched-seurat_v3]",
            ],
            "cwd": "${workspaceFolder}/learn/hvg_csc_dask",
            "console": "internalConsole",
            "justMyCode": false,
            "env": { "PYTEST_ADDOPTS": "--color=yes" },
            "presentation": { "group": "HVG lessons", "order": 5 },
        },
        {
            "name": "Lesson 5: Full pipeline (normalize_total layout flip)",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "module": "pytest",
            "args": [
                "-vv",
                "-s",
                "test_full_pipeline_ooc.py::test_full_pipeline_matches_in_memory",
            ],
            "cwd": "${workspaceFolder}/learn/hvg_csc_dask",
            "console": "internalConsole",
            "justMyCode": false,
            "env": { "PYTEST_ADDOPTS": "--color=yes" },
            "presentation": { "group": "HVG lessons", "order": 6 },
        },
        {
            "name": "Lesson 6: Real dask executor (LocalCluster)",
            "type": "debugpy",
            "request": "launch",
            "python": "${command:python.interpreterPath}",
            "module": "pytest",
            "args": [
                "-vv",
                "-s",
                "test_dask_executor.py::test_seurat_v3_under_local_cluster",
            ],
            "cwd": "${workspaceFolder}/learn/hvg_csc_dask",
            "console": "internalConsole",
            "justMyCode": false,
            "env": { "PYTEST_ADDOPTS": "--color=yes" },
            "presentation": { "group": "HVG lessons", "order": 7 },
        },
    ],
    "inputs": [
        {
            "id": "docsInterpreter",
            "type": "command",
            "command": "hatch.envInterpreter",
            "args": { "env": "docs" },
        },
    ],
}
